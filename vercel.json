{
  "builds": [
    { "src": "api/main.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/main.py" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "functions": {
    "api/main.py": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "30 14 * * 1-5" }
  ]
}
